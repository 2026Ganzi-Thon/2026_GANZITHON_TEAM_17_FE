+package com.ganzithon.wool.reply.controller;
+
+import com.ganzithon.wool.IntegrationTestSupport;
+import com.ganzithon.wool.reply.entity.Reply;
+import com.ganzithon.wool.reply.repository.ReplyRepository;
+import com.ganzithon.wool.user.entity.AgeGroup;
+import com.ganzithon.wool.user.entity.Role;
+import com.ganzithon.wool.user.entity.User;
+import com.ganzithon.wool.user.repository.UserRepository;
+import com.ganzithon.wool.worry.entity.Worry;
+import com.ganzithon.wool.worry.entity.WorryTag;
+import com.ganzithon.wool.worry.entity.WorryVisibility;
+import com.ganzithon.wool.worry.repository.WorryRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.transaction.annotation.Transactional;
+import java.util.UUID;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+@AutoConfigureMockMvc
+@Transactional
+class SeniorReplyDetailControllerTest extends IntegrationTestSupport {
+    @Autowired MockMvc mvc;
+    @Autowired UserRepository users;
+    @Autowired WorryRepository worries;
+    @Autowired ReplyRepository replies;
+    User youth, senior, other;
+    Worry worry;
+
+    @BeforeEach void setup() {
+        youth = user(Role.YOUTH);
+        senior = user(Role.SENIOR);
+        other = user(Role.SENIOR);
+        worry = worries.saveAndFlush(Worry.of(youth, "고민", "본문", WorryTag.CAREER, WorryVisibility.SENIORS_ONLY));
+    }
+
+    private User user(Role role) {
+        return users.saveAndFlush(User.join(role, role == Role.YOUTH ? AgeGroup.AGE_20S : AgeGroup.AGE_60S,
+                "검증" + UUID.randomUUID().toString().substring(0, 6)));
+    }
+
+    @Test void ownerReadsTextWithoutMarkingYouthFirstView() throws Exception {
+        var reply = replies.saveAndFlush(Reply.text(worry, senior, "내 답장"));
+        mvc.perform(get("/api/senior/replies/{id}", reply.getId()).header("X-User-Id", senior.getId()))
+                .andExpect(status().isOk()).andExpect(jsonPath("$.data.replyId").value(reply.getId()))
+                .andExpect(jsonPath("$.data.content").value("내 답장"));
+        assertThat(replies.findById(reply.getId()).orElseThrow().getFirstViewedAt()).isNull();
+    }
+
+    @Test void ownerReadsOriginalLetterPath() throws Exception {
+        String image = "/files/letters/11111111-1111-1111-1111-111111111111.jpg";
+        var reply = replies.saveAndFlush(Reply.letter(worry, senior, image));
+        mvc.perform(get("/api/senior/replies/{id}", reply.getId()).header("X-User-Id", senior.getId()))
+                .andExpect(status().isOk()).andExpect(jsonPath("$.data.type").value("LETTER"))
+                .andExpect(jsonPath("$.data.imageUrl").value(image));
+    }
+
+    @Test void anotherSeniorCannotReadTheReply() throws Exception {
+        var reply = replies.saveAndFlush(Reply.text(worry, senior, "내 답장"));
+        mvc.perform(get("/api/senior/replies/{id}", reply.getId()).header("X-User-Id", other.getId()))
+                .andExpect(status().isForbidden()).andExpect(jsonPath("$.code").value("REPLY_403_001"));
+    }
+
+    @Test void youthCannotUseSeniorRoute() throws Exception {
+        var reply = replies.saveAndFlush(Reply.text(worry, senior, "내 답장"));
+        mvc.perform(get("/api/senior/replies/{id}", reply.getId()).header("X-User-Id", youth.getId()))
+                .andExpect(status().isForbidden());
+    }
+
+    @Test void deletedReplyIsUnavailable() throws Exception {
+        var reply = replies.saveAndFlush(Reply.text(worry, senior, "내 답장"));
+        reply.delete(); replies.flush();
+        mvc.perform(get("/api/senior/replies/{id}", reply.getId()).header("X-User-Id", senior.getId()))
+                .andExpect(status().isNotFound());
+    }
+
+    @Test void hiddenWorryIsUnavailable() throws Exception {
+        var reply = replies.saveAndFlush(Reply.text(worry, senior, "내 답장"));
+        worry.hide(); worries.flush();
+        mvc.perform(get("/api/senior/replies/{id}", reply.getId()).header("X-User-Id", senior.getId()))
+                .andExpect(status().isNotFound());
+    }
+
+    @Test void hiddenReplyIsUnavailable() throws Exception {
+        var reply = replies.saveAndFlush(Reply.text(worry, senior, "내 답장"));
+        reply.hide(); replies.flush();
+        mvc.perform(get("/api/senior/replies/{id}", reply.getId()).header("X-User-Id", senior.getId()))
+                .andExpect(status().isNotFound());
+    }
+
+    @Test void deletedWorryIsUnavailable() throws Exception {
+        var reply = replies.saveAndFlush(Reply.text(worry, senior, "내 답장"));
+        worry.delete(); worries.flush();
+        mvc.perform(get("/api/senior/replies/{id}", reply.getId()).header("X-User-Id", senior.getId()))
+                .andExpect(status().isNotFound());
+    }
+}
