+package com.ganzithon.wool.reply.service;
+
+import com.ganzithon.wool.global.exception.BusinessException;
+import com.ganzithon.wool.reply.exception.ReplyErrorCode;
+import com.ganzithon.wool.reply.repository.ReplyRepository;
+import com.ganzithon.wool.reply.response.SeniorReplyDetailResponse;
+import com.ganzithon.wool.user.entity.User;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+@RequiredArgsConstructor
+public class SeniorReplyDetailService {
+    private final ReplyRepository replies;
+
+    // An owner read must not mark the youth's first view or change feedback eligibility.
+    @Transactional(readOnly = true)
+    public SeniorReplyDetailResponse view(User senior, Long replyId) {
+        var reply = replies.findByIdAndDeletedAtIsNull(replyId)
+                .orElseThrow(() -> new BusinessException(ReplyErrorCode.NOT_FOUND));
+        if (!reply.isWrittenBy(senior.getId())) {
+            throw new BusinessException(ReplyErrorCode.FORBIDDEN_VIEW);
+        }
+        var worry = reply.getWorry();
+        if (reply.isHidden() || worry.isHidden() || worry.isDeleted()) {
+            throw new BusinessException(ReplyErrorCode.NOT_FOUND);
+        }
+        return new SeniorReplyDetailResponse(reply.getId(), worry.getId(), reply.getType(),
+                reply.getContent(), reply.getImageUrl(), reply.getCreatedAt());
+    }
+}
